# Supply-chain hardening. See README › Security.

# Never run dependency install scripts (the usual way compromised packages attack). Nothing here needs them.
ignore-scripts=true
# If a dependency ever ships one, fail the install loudly instead of warning.
strict-allow-scripts=true
# Only install versions published at least 7 days ago; hijacked releases are usually caught and pulled within days.
min-release-age=7
# New dependencies are saved at an exact version, never a range.
save-exact=true
# Refuse to install on an unsupported Node version.
engine-strict=true
